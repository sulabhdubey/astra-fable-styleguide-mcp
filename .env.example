# MCP runtime
PORT=3000
HOST=127.0.0.1
MCP_ADMIN_TOKEN=replace-with-a-long-random-secret
MCP_ENABLE_WRITES=false
MCP_ENABLE_AI_ORCHESTRATION=false
MCP_ENABLE_RELEASE_TOOL=false
MCP_RELEASE_APPROVAL_TOKEN=replace-with-a-separate-human-held-secret
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_RATE_LIMIT_PER_MINUTE=120

# Logical agent roles. Models are intentionally configurable.
ASTRA_PROVIDER=openai
ASTRA_MODEL=gpt-5.6-sol
FABLE_PROVIDER=anthropic
FABLE_MODEL=claude-fable-5

# Prefer provider-wide keys. Role-specific ASTRA_API_KEY / FABLE_API_KEY override these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional provider tuning / compatible gateways
# ASTRA_REASONING_EFFORT=high
# ASTRA_MAX_TOKENS=8192
# FABLE_MAX_TOKENS=8192
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# ANTHROPIC_MESSAGES_URL=https://api.anthropic.com/v1/messages
