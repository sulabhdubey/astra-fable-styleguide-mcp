---
import Layout from '../../layouts.astro';
import { accessibility } from '../../lib/spec';
---
<Layout title="Accessibility"><h1>Accessibility</h1><p class="pill">{accessibility.baseline}</p>{accessibility.rules.map((r:any)=><div class="rule"><strong>{r.id} — {r.name}</strong><p>{r.requirement}</p></div>)}<h2>Required contrast pairs</h2><table><thead><tr><th>Rule</th><th>Foreground</th><th>Background</th><th>Minimum</th></tr></thead><tbody>{accessibility.contrastPairs.map((p:any)=><tr><td>{p.id}</td><td><code>{p.foreground}</code></td><td><code>{p.background}</code></td><td>{p.minimum}:1</td></tr>)}</tbody></table></Layout>
