---
import '../../../generated/css/tokens.css';
import './product.css';
const { title = 'Style Constitution', description = 'Give your coding agent shared design rules. Try a rendered UI check and a reviewed correction, right in your browser.' } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1D4ED8" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site"><nav class="nav" aria-label="Main navigation">
      <a class="brand" href={base}><span class="brand-mark" aria-hidden="true">s/c</span><span>Style Constitution<small>Astra + Fable</small></span></a>
      <div class="nav-links"><a href={`${base}demo/`}>Try demo</a><a href={`${base}start/`}>Connect</a><a href={`${base}components/`}>Reference</a><a href="https://github.com/sulabhdubey/astra-fable-styleguide-mcp">GitHub ↗</a></div>
    </nav></header>
    <main id="main" class="wrap"><slot /></main>
    <footer class="site-footer"><div class="footer-inner"><div><strong>Design intent, made explicit.</strong><p>Experimental software. Clear rules. Human-reviewed changes.</p></div><nav aria-label="Reference navigation"><a href={`${base}tokens/`}>Tokens</a><a href={`${base}accessibility/`}>Accessibility rules</a><a href={`${base}decisions/`}>Decisions</a><a href={`${base}mcp/`}>MCP reference</a><a href={`${base}feedback/`}>Give feedback</a></nav></div></footer>
  </body>
</html>
