---
const { title = 'Style Constitution' } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <style is:global>
      :root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#0f172a;background:#f8fafc}*{box-sizing:border-box}body{margin:0}a{color:#1d4ed8;text-decoration:none}a:hover{text-decoration:underline}header.site{position:sticky;top:0;background:rgba(248,250,252,.95);backdrop-filter:blur(10px);border-bottom:1px solid #e2e8f0;z-index:2}.nav{max-width:1120px;margin:auto;padding:14px 24px;display:flex;align-items:center;gap:18px;flex-wrap:wrap}.nav strong{margin-right:auto}.nav a{font-size:14px}.wrap{max-width:1120px;margin:auto;padding:44px 24px 72px}.hero{width:100%;border:1px solid #e2e8f0;border-radius:18px;background:white}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}.card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px}.muted{color:#475569}.pill{display:inline-block;background:#eef2ff;border-radius:999px;padding:4px 9px;font-size:12px;margin:2px}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#0f172a;color:#e2e8f0;border-radius:12px;padding:18px;overflow:auto}code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.rule{border-left:3px solid #2563eb;padding-left:12px;margin:12px 0}h1{font-size:clamp(2rem,5vw,4rem);line-height:1.02}h2{margin-top:40px}.table-scroll{max-width:100%;overflow-x:auto}.table-scroll table{min-width:640px}table{width:100%;border-collapse:collapse;background:white}th,td{text-align:left;padding:10px;border-bottom:1px solid #e2e8f0;vertical-align:top}
    </style>
  </head>
  <body>
    <header class="site"><nav class="nav"><strong><a href={base}>Style Constitution</a></strong><a href={`${base}start/`}>Start here</a><a href={`${base}tokens/`}>Tokens</a><a href={`${base}components/`}>Components</a><a href={`${base}accessibility/`}>Accessibility</a><a href={`${base}decisions/`}>Decisions</a><a href={`${base}mcp/`}>MCP</a></nav></header>
    <main class="wrap"><slot /></main>
  </body>
</html>
