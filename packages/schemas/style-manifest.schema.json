{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Style Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "status",
    "schemaVersion",
    "compatibility"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "candidate",
        "released"
      ]
    },
    "schemaVersion": {
      "type": "string"
    },
    "compatibility": {
      "type": "object"
    }
  }
}
